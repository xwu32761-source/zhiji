generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 核心业务模型 ==========

model User {
  id        String    @id @default(uuid())
  name      String?
  email     String?   @unique
  emailVerified DateTime? @map("email_verified")
  image     String?
  anonymousId String?  @unique @map("anonymous_id")
  nickname  String   @default("探索者")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // 关联
  profiles     UserProfile[]
  diaryEntries DiaryEntry[]
  lifeManuals  LifeManual[]

  // NextAuth 关联
  accounts Account[]
  sessions Session[]

  @@map("users")
}

model UserProfile {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  basicAnswers   Json     @map("basic_answers")       // {"p1": {"q1": "A"}, ...}
  deepTags       Json?    @map("deep_tags")            // ["tag_101", "tag_205"]
  pillarCompleted Json?   @map("pillar_completed")     // [1, 2, 3]
  pillarData     Json?    @map("pillar_data")          // 完整支柱答题状态：Record<number, PillarAnswers>
  firstProfileAt DateTime? @map("first_profile_at")
  lastSealAt     DateTime? @map("last_seal_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId])
  @@map("user_profiles")
}

model DiaryEntry {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  entryType    String   @map("entry_type")        // emotion / behavior / intake / narrative
  coreTag      String?  @map("core_tag")          // 愤怒 / 跑步 / 冰美式
  intensity    Int?                               // 1-5
  source       String?                            // 他人 / 自身 / 外物
  note         String?                            // 用户自定义短句
  aiHook       String?  @map("ai_hook")           // AI 记忆钩子
  linkedPillars Json?   @map("linked_pillars")    // [2, 4]
  fullReport   String?  @map("full_report")       // 叙事完整报告
  score        Int?                               // -5 ~ +5
  entryDate    DateTime @map("entry_date")         // 记录日期
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, entryDate(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("diary_entries")
}

model LifeManual {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  version     Int      @default(1)
  coverTitle  String?  @map("cover_title")
  fullText    String?  @map("full_text")
  isCurrent   Boolean  @default(true) @map("is_current")
  generatedAt DateTime @default(now()) @map("generated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isCurrent])
  @@map("life_manuals")
}

// ========== NextAuth 认证模型 ==========

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
